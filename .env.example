# ==============================================================================
# UPI Payment Tracker - Environment Configuration Template
# For Vercel Hosting & Supabase PostgreSQL
# ==============================================================================

# Server Port (Local Dev)
PORT=5000

# ------------------------------------------------------------------------------
# 1. Database Connection (Supabase Cloud PostgreSQL)
# Copy the Connection URI from Supabase:
# Settings -> Database -> Connection string -> URI (Session Pooler, Port 5432)
# Replace [YOUR-PASSWORD] with your actual Supabase database password (WITHOUT brackets)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.yourprojectid:your_db_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 2. Application Security (Dashboard App Lock PIN)
# Set a 4 to 6 digit PIN (e.g. 1234 or 9472) to lock the dashboard from the public.
# When set, anyone opening your Vercel URL must enter this PIN to view transactions.
# ------------------------------------------------------------------------------
APP_PIN=1234

# ------------------------------------------------------------------------------
# 3. MacroDroid / Automation SMS Webhook Secret
# Protects your webhook from fake transaction spam.
# In MacroDroid HTTP Request, pass: ?secret=your_webhook_secret_here
# or header: x-webhook-secret: your_webhook_secret_here
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=upi_tracker_secret_token_123

# Secret key used to cryptographically sign session tokens (optional, random fallback used)
SESSION_SECRET=upi_flow_super_secret_session_key_2026

# ------------------------------------------------------------------------------
# 4. Local PostgreSQL Fallback (Only used if DATABASE_URL is not set)
# ------------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=payment_tracker
PGUSER=postgres
PGPASSWORD=

# ------------------------------------------------------------------------------
# 5. Automated Bank Email Sync via IMAP (Optional)
# ------------------------------------------------------------------------------
EMAIL_SYNC_ENABLED=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_SYNC_INTERVAL_MINS=15
